import tkinter as tk
from tkinter import ttk
import json
import os

def save_data():
    try:
        with open("data.json", "w") as f:
            json.dump({"shipments": [], "status": []}, f)
    except Exception as e:
        print(f"Error saving data: {e}")

def load_data():
    try:
        with open("data.json", "r") as f:
            data = json.load(f)
            shipments, status = data
            return shipments, status
    except FileNotFoundError:
        return [], []
    except json.JSONDecodeError:
        print("Error decoding data.json")
        return [], []

def display_data():
    try:
        shipments = shipments
        status = status
        if shipments:
            shipment_list = ttk.Treeview(self.root, columns=("Tracking ID", "Status"), show="headings")
            shipment_list.heading("Tracking ID", text="Tracking ID")
            shipment_list.heading("Status", text="Status")
            shipment_list.column("Tracking ID", width=200)
            shipment_list.column("Status", width=100)
            shipment_list.pack(fill="both", expand=True)
            
            for shipment in shipments:
                label = tk.Label(self.root, text=f"Tracking ID: {shipment['Tracking ID']}")
                label.pack(pady=5)
                
        else:
            label = tk.Label(self.root, text="No shipments found.")
            label.pack(pady=5)
    except Exception as e:
        print(f"Error displaying data: {e}")

